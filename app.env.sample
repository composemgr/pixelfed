# Pixelfed environment configuration
# Copy to app.env and adjust values as needed

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=pixelfed
BASE_DOMAIN_NAME=example.com

# Application
APP_ORG_NAME=Pixelfed
APP_SECRET_KEY=replace-with-a-random-secret-key-min-32-chars

# Database (MySQL)
DB_CREATE_DATABASE_NAME=pixelfed
DB_USER_NAME=pixelfed
DB_USER_PASS=replace-with-a-random-password
DB_ADMIN_PASS=replace-with-a-random-password

# Email / SMTP
EMAIL_DRIVER=log
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_LOGIN_NAME=
EMAIL_SERVER_LOGIN_PASS=replace-with-a-random-password
EMAIL_SERVER_MAIL_FROM=no-reply@pixelfed.example.com
EMAIL_ENCRYPTION=null

# Registration
OPEN_REGISTRATION=false
ENFORCE_EMAIL_VERIFICATION=false
